{
  "about": "What junoscfg's validators report on each device capture (tests/corpus/test_device_renderings.py::TestTheValidatorsTakeWhatTheDevicePrinted). A device loaded every statement of a capture, so each finding is recorded with its class; a finding not recorded fails the law, and so does a recorded one that is gone. Doors: `field` is field validation of the rendering read by its own reader; `schema` is `validate_config` of the device's JSON rendering; `json-output` is `validate_config` of junoscfg's JSON output of the rendering. A key is `<path> :: <message>`.",
  "classes": {
    "mandatory-the-device-warns": {
      "definition": "a statement the XSD marks mandatory is absent; the device loads the configuration and warns about it too (`## Warning: missing mandatory statement(s)` in its curly rendering), so the finding is the configuration's own",
      "severity": "warning"
    },
    "mandatory-open": {
      "definition": "a statement the XSD marks mandatory is absent and the device printed no warning for it; whether `commit check` passes is an open device question (hold-time with only `down`)",
      "severity": "warning"
    }
  },
