{
 "classes": {
  "bare-deactivate-route-filter": {
   "definition": "the device's display set prints an inactive route-filter as a bare `deactivate` with no `set` line for it",
   "kind": "device-quirk"
  },
  "junos-variable-quoted": {
   "definition": "junoscfg quotes `$junos-...` variables the device prints bare; the device loads both as the same configuration",
   "kind": "equivalent"
  },
  "omitted-curly": {
   "definition": "the device's curly prints a group with `apply-flags omit` as `/* OMITTED */`, so the curly rendering lacks that group's content; XML, JSON and set carry it",
   "kind": "device-quirk"
  },
  "trigger-after-one-line": {
   "definition": "junoscfg writes `within N trigger after 1` as one set line where the device prints two; whether set input loads both alike needs a device load test",
   "kind": "open"
  },
  "trigger-after-split": {
   "definition": "the device's display set prints `within N trigger after 1` as two lines, `... trigger after` and `... trigger 1`; curly, XML and JSON hold one statement",
   "kind": "device-quirk"
  },
  "xml-element-name-leak": {
   "definition": "from XML or JSON, an element the CLI hides appears in the set path (rf_list, server-group server-group, other-variables, bridge-domains domain, dynamic-tunnels dynamic-tunnel, hello-padding-type); the same statements curly input reports as not placed in the schema",
   "kind": "defect"
  }
 },
