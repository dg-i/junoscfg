weighted_averaged: "instant-usage-weight-exponent" QUOTED_OR_VALUE

west_interface: "control-channel" control_channel? | "interface-none" | "ring-protection-link-end"

when: "chassis" QUOTED_OR_VALUE | "member" QUOTED_OR_VALUE | "model" QUOTED_OR_VALUE | "node" QUOTED_OR_VALUE | "peers" QUOTED_OR_VALUE | "routing-engine" QUOTED_OR_VALUE | "time" time?

whitelist: "filename" QUOTED_OR_VALUE | "ip-address-list" QUOTED_OR_VALUE

wildcard_address: "wildcard-mask" QUOTED_OR_VALUE | QUOTED_OR_VALUE

wildcard_group_inet: "wildcard-source" wildcard_source?

wildcard_group_inet6: "wildcard-source" wildcard_source?

wildcard_source: "bier" bier? | "ingress-replication" ingress_replication? | "inter-region-segmented" inter_region_segmented? | "ldp-p2mp" ldp_p2mp? | "next-hop" QUOTED_OR_VALUE | "pim-ssm" pim_ssm? | "rsvp-te" rsvp_te? | "threshold-rate" QUOTED_OR_VALUE

window_scale: "match" QUOTED_OR_VALUE | "value" QUOTED_OR_VALUE

window_size: "match" QUOTED_OR_VALUE | "value" QUOTED_OR_VALUE

withdraw_priority: "expedited" | "priority" QUOTED_OR_VALUE

within: "within-value" QUOTED_OR_VALUE | "within-variable" QUOTED_OR_VALUE

within__list: QUOTED_OR_VALUE ("events" QUOTED_OR_VALUE | "not" not? | "trigger" trigger?)?

wsp: "content-type" content_type? | "operation" operation?

xauth: "access-profile" QUOTED_OR_VALUE | "ip-address" QUOTED_OR_VALUE

xauth_attributes: "primary-dns" QUOTED_OR_VALUE | "primary-dns-ipv6" QUOTED_OR_VALUE | "primary-wins" QUOTED_OR_VALUE | "secondary-dns" QUOTED_OR_VALUE | "secondary-dns-ipv6" QUOTED_OR_VALUE | "secondary-wins" QUOTED_OR_VALUE

xe: "port" QUOTED_OR_VALUE? | "port-range" QUOTED_OR_VALUE?

xg_pon1: "overhead-adjust" QUOTED_OR_VALUE | "overhead-bytes" QUOTED_OR_VALUE | "total-adjust" QUOTED_OR_VALUE

xgs_pon: "overhead-adjust" QUOTED_OR_VALUE | "overhead-bytes" QUOTED_OR_VALUE | "total-adjust" QUOTED_OR_VALUE

xle: "port" QUOTED_OR_VALUE? | "port-range" QUOTED_OR_VALUE?

xnm_clear_text: "connection-limit" QUOTED_OR_VALUE | "rate-limit" QUOTED_OR_VALUE

xnm_ssl: "connection-limit" QUOTED_OR_VALUE | "local-certificate" QUOTED_OR_VALUE | "no-ssl-renegotiation" | "rate-limit" QUOTED_OR_VALUE | "ssl-renegotiation"

xor: "en-ip-over-mpls" | "mac-addresses" | "no-L3-L4-headers" | "no-L4-ports" | "no-destination-mac-address" | "no-ip6-flow-label" | "no-ipv4-destination-address" | "no-ipv4-source-address" | "no-ipv6-destination-address" | "no-ipv6-source-address" | "no-l4-destination-port" | "no-l4-source-port" | "no-mpls-hash" | "no-mpls-label0" | "no-mpls-label1" | "no-source-mac-address"

yang_module_capabilities: "advertise-custom-yang-modules" | "advertise-native-yang-modules" | "advertise-standard-yang-modules"

yang_modules: "device-specific" | "emit-anyxml-in-rpc-output" | "emit-extensions" | "emit-family-ns-and-module-name" | "rpc-output-verbose"

zero_suppression: "no-zero-suppression"

// Terminals
SET: "set"
DEACTIVATE: "deactivate"
VALUE: /\S+/
QUOTED: /"[^"]*"/
QUOTED_OR_VALUE: QUOTED | VALUE

// Whitespace handling
%import common.WS
%ignore WS

