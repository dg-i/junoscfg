# OpenSpec regenerates its slash commands as skills under a `source-command-`
# prefix on unrelated invocations (seen on `openspec archive`). They are derived
# from the gitignored .claude/commands/opsx/ and would bring back the OpenSpec
# workflow skills retired from discovery (`agent-ready skills --retire-openspec`).
# Keep them out of the tree.
.agents/skills/source-command-*/
tmp/
local-test-data/

# Coverage data written by the full set and CI
.coverage
.coverage.*
coverage.xml
htmlcov/
.agent-ready/verification/

# Prepared schema runtime and generated verification products
.agent-ready/schema/
