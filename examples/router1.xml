<configuration>
    <system>
        <host-name>router1</host-name>
        <domain-name>example.com</domain-name>
        <time-zone>UTC</time-zone>
        <root-authentication>
            <encrypted-password>$9$ExAmPlEhAsH.KEY</encrypted-password>
        </root-authentication>
        <name-server>
            <name>192.168.0.53</name>
        </name-server>
        <name-server>
            <name>192.168.0.54</name>
        </name-server>
        <login>
            <user>
                <name>admin</name>
                <uid>2000</uid>
                <class>super-user</class>
                <authentication>
                    <encrypted-password>$9$ExAmPlEhAsH.KEY</encrypted-password>
                </authentication>
            </user>
            <user>
                <name>operator</name>
                <uid>2001</uid>
                <class>read-only</class>
                <authentication>
                    <encrypted-password>$9$ExAmPlEhAsH.KEY</encrypted-password>
                </authentication>
            </user>
        </login>
        <services>
            <ssh>
                <root-login>deny</root-login>
                <protocol-version>v2</protocol-version>
            </ssh>
            <netconf>
                <ssh/>
            </netconf>
        </services>
        <syslog>
            <user>
                <name>*</name>
                <contents>
                    <name>any</name>
                    <emergency/>
                </contents>
            </user>
            <file>
                <name>messages</name>
                <contents>
                    <name>any</name>
                    <notice/>
                </contents>
                <contents>
                    <name>authorization</name>
                    <info/>
                </contents>
            </file>
            <host>
                <name>192.168.0.10</name>
                <contents>
                    <name>any</name>
                    <warning/>
                </contents>
            </host>
        </syslog>
        <ntp>
            <server>
                <name>192.168.0.123</name>
            </server>
        </ntp>
    </system>
    <interfaces>
        <interface>
            <name>ge-0/0/0</name>
            <description>uplink to core</description>
            <mtu>9192</mtu>
            <unit>
                <name>0</name>
                <family>
                    <inet>
                        <address>
                            <name>198.51.100.1/30</name>
                        </address>
                    </inet>
                    <inet6>
                        <address>
                            <name>2001:db8:100::1/126</name>
                        </address>
                    </inet6>
                </family>
            </unit>
        </interface>
        <interface>
            <name>ge-0/0/1</name>
            <description>downlink to access</description>
            <unit>
                <name>0</name>
                <vlan-id>100</vlan-id>
                <family>
                    <inet>
                        <address>
                            <name>10.0.100.1/24</name>
                        </address>
                    </inet>
                </family>
            </unit>
        </interface>
        <interface>
            <name>ge-0/0/2</name>
            <description>customer handoff</description>
            <ether-options>
                <ieee-802.3ad>
                    <bundle>ae0</bundle>
                </ieee-802.3ad>
            </ether-options>
        </interface>
        <interface>
            <name>ge-0/0/3</name>
            <description>customer handoff backup</description>
            <ether-options>
                <ieee-802.3ad>
                    <bundle>ae0</bundle>
                </ieee-802.3ad>
            </ether-options>
        </interface>
        <interface>
            <name>ae0</name>
            <description>bundled customer handoff</description>
            <aggregated-ether-options>
                <lacp>
                    <active/>
                </lacp>
            </aggregated-ether-options>
            <unit>
                <name>0</name>
                <family>
                    <inet>
                        <address>
                            <name>10.0.200.1/24</name>
                        </address>
                    </inet>
                </family>
            </unit>
        </interface>
        <interface>
            <name>lo0</name>
            <unit>
                <name>0</name>
                <family>
                    <inet>
                        <address>
                            <name>10.255.255.1/32</name>
                        </address>
                    </inet>
                </family>
            </unit>
        </interface>
    </interfaces>
    <routing-options>
        <router-id>10.255.255.1</router-id>
        <autonomous-system>
            <as-number>64496</as-number>
        </autonomous-system>
        <static>
            <route>
                <name>0.0.0.0/0</name>
                <next-hop>198.51.100.2</next-hop>
            </route>
        </static>
    </routing-options>
    <protocols>
        <bgp>
            <group>
                <name>ebgp-peers</name>
                <type>external</type>
                <peer-as>64497</peer-as>
                <neighbor>
                    <name>198.51.100.2</name>
                    <description>transit provider</description>
                    <import>import-transit</import>
                    <export>export-customers</export>
                </neighbor>
            </group>
            <group>
                <name>ibgp-peers</name>
                <type>internal</type>
                <local-address>10.255.255.1</local-address>
                <neighbor>
                    <name>10.255.255.2</name>
                    <description>core router</description>
                </neighbor>
            </group>
        </bgp>
        <ospf>
            <area>
                <name>0.0.0.0</name>
                <interface>
                    <name>ge-0/0/0.0</name>
                    <metric>10</metric>
                </interface>
                <interface>
                    <name>lo0.0</name>
                    <passive/>
                </interface>
            </area>
        </ospf>
        <lldp>
            <interface>
                <name>all</name>
            </interface>
        </lldp>
    </protocols>
    <policy-options>
        <policy-statement>
            <name>import-transit</name>
            <term>
                <name>reject-bogons</name>
                <from>
                    <route-filter>
                        <address>10.0.0.0/8</address>
                        <orlonger/>
                    </route-filter>
                </from>
                <then>
                    <reject/>
                </then>
            </term>
            <term>
                <name>accept-rest</name>
                <then>
                    <accept/>
                </then>
            </term>
        </policy-statement>
        <policy-statement>
            <name>export-customers</name>
            <term>
                <name>customers</name>
                <from>
                    <community>customer-routes</community>
                </from>
                <then>
                    <accept/>
                </then>
            </term>
            <term>
                <name>default</name>
                <then>
                    <reject/>
                </then>
            </term>
        </policy-statement>
        <community>
            <name>customer-routes</name>
            <members>64496:100</members>
        </community>
    </policy-options>
    <firewall>
        <family>
            <inet>
                <filter>
                    <name>protect-re</name>
                    <term>
                        <name>allow-ssh</name>
                        <from>
                            <source-address>
                                <name>10.0.0.0/8</name>
                            </source-address>
                            <protocol>tcp</protocol>
                            <destination-port>ssh</destination-port>
                        </from>
                        <then>
                            <accept/>
                        </then>
                    </term>
                    <term>
                        <name>discard-rest</name>
                        <then>
                            <discard/>
                        </then>
                    </term>
                </filter>
            </inet>
        </family>
    </firewall>
</configuration>
