        "interfaces": {
            "interface": [
                {
                    "name": "ge-0/0/0",
                    "description": "uplink to core",
                    "mtu": "9192",
                    "unit": [
                        {
                            "name": "0",
                            "family": {
                                "inet": {
                                    "address": [
                                        {
                                            "name": "198.51.100.1/30"
                                        }
                                    ]
                                },
                                "inet6": {
                                    "address": [
                                        {
                                            "name": "2001:db8:100::1/126"
                                        }
                                    ]
                                }
                            }
                        }
                    ]
                },
                {
                    "name": "ge-0/0/1",
